{
  "name": "@natsuneko-laboratory/archon",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "archon": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    }
  },
  "files": [
    "dist",
    "runtimes"
  ],
  "scripts": {
    "build": "node scripts/copy-runtimes.mjs && tsup",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3",
    "cac": "^6.7.14",
    "jiti": "^2.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
