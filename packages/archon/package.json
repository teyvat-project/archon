{
  "name": "@natsuneko-laboratory/archon",
  "version": "0.1.0",
  "description": "Generate SDKs with minimal dependencies for TypeScript, C#, Kotlin, Swift, Rust and Go from OpenAPI 3.0 / 3.1 specs",
  "keywords": [
    "openapi",
    "swagger",
    "sdk",
    "codegen",
    "generator",
    "typescript",
    "csharp",
    "kotlin",
    "swift",
    "rust",
    "go"
  ],
  "license": "MIT",
  "homepage": "https://github.com/teyvat-project/archon#readme",
  "bugs": {
    "url": "https://github.com/teyvat-project/archon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teyvat-project/archon.git",
    "directory": "packages/archon"
  },
  "type": "module",
  "bin": {
    "archon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    }
  },
  "files": [
    "dist",
    "runtimes"
  ],
  "scripts": {
    "build": "node scripts/copy-runtimes.mjs && tsdown",
    "prepack": "node scripts/copy-package-files.mjs && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "cac": "^7.1.0",
    "jiti": "^2.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
