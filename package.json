{
  "name": "archon-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "pnpm -F @natsuneko-laboratory/archon-e2e-typescript test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:e2e:csharp": "pnpm -F @natsuneko-laboratory/archon-e2e-csharp test",
    "test:e2e:kotlin": "pnpm -F @natsuneko-laboratory/archon-e2e-kotlin test",
    "test:e2e:swift": "pnpm -F @natsuneko-laboratory/archon-e2e-swift test",
    "test:e2e:rust": "pnpm -F @natsuneko-laboratory/archon-e2e-rust test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
